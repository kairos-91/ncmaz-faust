# SQLite local: no hace falta instalar nada, el archivo se crea solo.
DATABASE_URI=file:./portafolio.db

# Cadena aleatoria y larga. Firma las sesiones del panel.
PAYLOAD_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# URL publica del sitio (para Live Preview y los enlaces "ver en el sitio").
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Para cambiar a Postgres / Supabase ---
# 1. npm i @payloadcms/db-postgres  (y quita @payloadcms/db-sqlite)
# 2. En src/payload.config.ts cambia sqliteAdapter por postgresAdapter
# 3. DATABASE_URI=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
